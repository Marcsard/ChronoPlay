<Window x:Class="ChronoPlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChronoPlay"
        Background="{StaticResource AppBg}"
        Height="700"
        Width="1200"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <DockPanel Background="{StaticResource AppBg}">

        <Border Background="{StaticResource SidebarBg}"
                BorderBrush="{StaticResource BorderGradient}"
                BorderThickness="0,0,1,0"
                Width="220"
                DockPanel.Dock="Left">

            <StackPanel Margin="15">

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,30">
                    <Image Source="{StaticResource ChronoPlayWindowIcon}"
                           Width="36"
                           Height="36"
                           Stretch="Uniform"
                           Margin="0,0,10,0"/>
                    <TextBlock Text="CHRONOPLAY"
                               FontFamily="{StaticResource OrbitronFont}"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Height="40"
                        Margin="0,5"
                        Content="Dashboard"/>

                <Button Height="40"
                        Margin="0,5"
                        Content="Consolas"/>

                <Button Height="40"
                        Margin="0,5"
                        Content="Inventario"/>

                <Button Height="40"
                        Margin="0,5"
                        Content="Ventas"/>

                <Button Height="40"
                        Margin="0,5"
                        Content="Reportes"/>

            </StackPanel>

        </Border>

        <ScrollViewer>

            <StackPanel Margin="20">
                <TextBlock Text="// PANEL DE CONTROL"
                           FontFamily="{StaticResource ShareTechMonoFont}"
                           Foreground="{StaticResource Cyan}"/>
                <TextBlock Text="CONSOLAS"
                           Style="{StaticResource SectionTitleStyle}"
                           FontSize="26"
                           Margin="0,4,0,12"/>
            <WrapPanel>

                <Border Width="180"
                        Height="120"
                        Background="{StaticResource SurfaceElevatedBrush}"
                        Margin="10"
                        CornerRadius="10">

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="PS4-01"
                                   FontFamily="{StaticResource OrbitronFont}"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,5"/>

                        <TextBlock Text="LIBRE"
                                   Foreground="{StaticResource Free}"
                                   FontFamily="{StaticResource OrbitronFont}"
                                   FontSize="18"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>

            </WrapPanel>
            </StackPanel>

        </ScrollViewer>

    </DockPanel>

</Window>