<Window x:Class="ChronoPlay.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ChronoPlay.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ChronoPlay Login"
        Background="{StaticResource AppBg}"
        WindowStyle="None"
        controls:WindowWorkAreaBehavior.KeepInWorkArea="True"
        Height="520"
        Width="460"
        MinWidth="420"
        MinHeight="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Style="{StaticResource WindowChromeRootStyle}" Background="{StaticResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <controls:AppTitleBar Grid.Row="0"
                              Title="LOGIN"
                              IconGeometry="{StaticResource AppIconLoginGeometry}"
                              ShowMaximize="False"/>
        <Grid Grid.Row="1" Background="{StaticResource AppBg}">
        <Border Style="{StaticResource CardBorderStyle}"
                Width="360"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="// ACCESO"
                           FontFamily="{StaticResource ShareTechMonoFont}"
                                       Foreground="{StaticResource Cyan}"
                                       HorizontalAlignment="Center"/>
                           <ContentControl Content="{StaticResource AppIconLoginGeometry}"
                                           Style="{StaticResource AppIconBadgeStyle}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,4"/>
                           <TextBlock Text="CHRONOPLAY"
                           FontFamily="{StaticResource OrbitronFont}"
                           FontSize="30"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Centro de entretenimiento"
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,24"/>

                <TextBlock Text="Usuario" Style="{StaticResource FieldLabelStyle}"/>
                <Border Background="{StaticResource CardInnerBg}"
                        BorderBrush="{StaticResource BorderGradient}"
                        BorderThickness="1"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="{StaticResource AppIconUserGeometry}"
                              Width="18" Height="18"
                              Fill="Transparent"
                              Stroke="{StaticResource TextMuted}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                        <TextBox x:Name="txtUsuario"
                                 Grid.Column="1"
                                 Height="42"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0,7,10,7"/>
                    </Grid>
                </Border>

                <TextBlock Text="Contraseña" Style="{StaticResource FieldLabelStyle}"/>
                <Border Background="{StaticResource CardInnerBg}"
                        BorderBrush="{StaticResource BorderGradient}"
                        BorderThickness="1"
                        Margin="0,0,0,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="{StaticResource AppIconLoginGeometry}"
                              Width="18" Height="18"
                              Fill="Transparent"
                              Stroke="{StaticResource TextMuted}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                        <PasswordBox x:Name="txtPassword"
                                     Grid.Column="1"
                                     Height="42"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0,7,10,7"/>
                    </Grid>
                </Border>

                <Button Height="44"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Ingresar_Click">
                    <DockPanel LastChildFill="True">
                        <Path DockPanel.Dock="Right"
                              Data="M2,8 H16 M11,3 L16,8 L11,13"
                              Width="18" Height="16"
                              Stroke="{StaticResource TextPrimary}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"
                              Margin="8,0,0,0"/>
                        <TextBlock Text="Ingresar"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</Window>