<Window x:Class="ChronoPlay.Views.SeleccionarTiempoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar tiempo"
        Background="{StaticResource AppBg}"
        Height="640"
        Width="460"
        MinWidth="420"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="OptionCard"
                                Background="{StaticResource PanelBg}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12">
                            <Grid>
                                <ContentPresenter Margin="0,0,28,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch"/>
                                <Path x:Name="SelectedIndicator"
                                      Data="M4,10 L8,14 L16,5"
                                      Width="14" Height="14"
                                      Stroke="{StaticResource AccentLight}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OptionCard" Property="Background" Value="{StaticResource CardInnerBg}"/>
                                <Setter TargetName="OptionCard" Property="BorderBrush" Value="{StaticResource AccentLight}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OptionCard" Property="Background" Value="{StaticResource NavActiveBg}"/>
                                <Setter TargetName="OptionCard" Property="BorderBrush" Value="{StaticResource BorderActiveGradient}"/>
                                <Setter TargetName="SelectedIndicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="OptionCard" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24" Background="{StaticResource AppBg}">
        <Border Style="{StaticResource CardBorderStyle}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="// NUEVA SESIÓN"
                               FontFamily="{StaticResource ShareTechMonoFont}"
                               Foreground="{StaticResource Cyan}"/>
                    <TextBlock Text="DURACIÓN DE LA SESIÓN"
                               FontFamily="{StaticResource OrbitronFont}"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,4,0,5"/>
                    <TextBlock Text="Selecciona cuánto tiempo deseas jugar"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <RadioButton x:Name="rb30" Grid.Row="0" Margin="0,0,0,6" Padding="12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource AppIconHistoryGeometry}" Width="25" Height="25" Margin="0,0,10,0"
                                  Fill="Transparent" Stroke="{StaticResource AccentLight}" StrokeThickness="1.8" Stretch="Uniform"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="30 minutos" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Sesión corta" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="rb60" Grid.Row="1" Margin="0,6" Padding="12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource AppIconHistoryGeometry}" Width="25" Height="25" Margin="0,0,10,0"
                                  Fill="Transparent" Stroke="{StaticResource AccentLight}" StrokeThickness="1.8" Stretch="Uniform"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="1 hora" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Sesión estándar" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="rb120" Grid.Row="2" Margin="0,6" Padding="12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource AppIconHistoryGeometry}" Width="25" Height="25" Margin="0,0,10,0"
                                  Fill="Transparent" Stroke="{StaticResource AccentLight}" StrokeThickness="1.8" Stretch="Uniform"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="2 horas" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Sesión larga" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="rbLibre" Grid.Row="3" Margin="0,6,0,0" Padding="12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource AppIconHistoryGeometry}" Width="25" Height="25" Margin="0,0,10,0"
                                  Fill="Transparent" Stroke="{StaticResource AccentLight}" StrokeThickness="1.8" Stretch="Uniform"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Tiempo libre" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Sin límite" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>
                </Grid>

                <Button Grid.Row="2"
                        Content="Continuar"
                        Height="44"
                        Margin="0,16,0,0"
                        Click="Aceptar_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=rb30}" Value="True">
                                    <Setter Property="IsEnabled" Value="True"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=rb60}" Value="True">
                                    <Setter Property="IsEnabled" Value="True"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=rb120}" Value="True">
                                    <Setter Property="IsEnabled" Value="True"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=rbLibre}" Value="True">
                                    <Setter Property="IsEnabled" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>