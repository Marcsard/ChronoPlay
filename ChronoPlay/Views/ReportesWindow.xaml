<Window x:Class="ChronoPlay.Views.ReportesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ChronoPlay.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Reportes"
        Background="{StaticResource AppBg}"
        WindowStyle="None"
        controls:WindowWorkAreaBehavior.KeepInWorkArea="True"
        Height="700"
        Width="900"
        MinWidth="640"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ReportComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="{StaticResource CardInnerBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentLight}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Style="{StaticResource WindowChromeRootStyle}" Background="{StaticResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <controls:AppTitleBar Grid.Row="0"
                              Title="REPORTES"
                              IconGeometry="{StaticResource AppIconReportGeometry}"/>
        <Grid Grid.Row="1" Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource BorderGradient}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Margin="5">
                <ContentControl Content="{StaticResource AppIconReportGeometry}"
                                Style="{StaticResource AppIconBadgeStyle}"
                                Margin="0,0,14,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="// ANÁLISIS"
                               FontFamily="{StaticResource ShareTechMonoFont}"
                               Foreground="{StaticResource Cyan}"/>
                    <TextBlock Text="REPORTES"
                               Style="{StaticResource SectionTitleStyle}"
                               FontSize="26"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource BorderGradient}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Año" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="cmbAnio" Width="150" Style="{StaticResource ReportComboBoxStyle}"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Mes" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="cmbMes" Width="200" Style="{StaticResource ReportComboBoxStyle}"/>
                </StackPanel>
                <Button Width="130"
                        Height="40"
                        Margin="0,18,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Consultar_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 M16,16 L22,22"
                              Width="16" Height="16" Margin="0,0,8,0"
                              Fill="Transparent" Stroke="{StaticResource TextPrimary}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Stretch="Uniform"/>
                        <TextBlock Text="Consultar" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}"
                CornerRadius="10"
                Margin="0,20,0,0">

            <Grid>
                <StackPanel Margin="20">
                    <TextBlock Text="// RESUMEN"
                               FontFamily="{StaticResource ShareTechMonoFont}"
                               Foreground="{StaticResource Cyan}"/>
                    <TextBlock Text="RESULTADOS DEL REPORTE"
                               FontFamily="{StaticResource OrbitronFont}"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock x:Name="txtConsolas" Foreground="{StaticResource Free}" FontFamily="{StaticResource ShareTechMonoFont}" FontSize="20" Margin="0,20,0,0"/>
                    <TextBlock x:Name="txtProductos" Foreground="{StaticResource Free}" FontFamily="{StaticResource ShareTechMonoFont}" FontSize="20"/>
                    <TextBlock x:Name="txtCompras" Foreground="{StaticResource DangerGlow}" FontFamily="{StaticResource ShareTechMonoFont}" FontSize="20" Margin="0,20,0,0"/>
                    <TextBlock x:Name="txtExtras" Foreground="{StaticResource DangerGlow}" FontFamily="{StaticResource ShareTechMonoFont}" FontSize="20"/>
                    <TextBlock x:Name="txtGanancia" Foreground="{StaticResource Price}" FontFamily="{StaticResource ShareTechMonoFont}" FontSize="36" FontWeight="Bold" Margin="0,30,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Text, ElementName=txtConsolas}" Value=""/>
                                        <Condition Binding="{Binding Text, ElementName=txtProductos}" Value=""/>
                                        <Condition Binding="{Binding Text, ElementName=txtCompras}" Value=""/>
                                        <Condition Binding="{Binding Text, ElementName=txtExtras}" Value=""/>
                                        <Condition Binding="{Binding Text, ElementName=txtGanancia}" Value=""/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ContentControl Content="{StaticResource AppIconReportGeometry}"
                                    Style="{StaticResource AppIconBadgeStyle}"
                                    HorizontalAlignment="Center"/>
                    <TextBlock Text="Sin resultados. Selecciona año y mes y pulsa Consultar."
                               Foreground="{StaticResource TextMuted}"
                               FontSize="16"
                               TextAlignment="Center"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>

        </Border>

        </Grid>
    </Grid>

</Window>
