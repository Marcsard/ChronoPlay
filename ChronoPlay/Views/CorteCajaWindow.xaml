<Window x:Class="ChronoPlay.Views.CorteCajaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ChronoPlay.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Corte de Caja"
        Background="{StaticResource AppBg}"
        WindowStyle="None"
        controls:WindowWorkAreaBehavior.KeepInWorkArea="True"
        Height="700"
        Width="900"
        MinWidth="640"
        MinHeight="500"
        WindowStartupLocation="CenterOwner">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Style="{StaticResource WindowChromeRootStyle}" Background="{StaticResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <controls:AppTitleBar Grid.Row="0"
                              Title="CORTE DE CAJA"
                              IconGeometry="{StaticResource AppIconCashGeometry}"/>
        <Grid Grid.Row="1" Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource BorderGradient}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Margin="5">
                <ContentControl Content="{StaticResource AppIconCashGeometry}"
                                Style="{StaticResource AppIconBadgeStyle}"
                                Margin="0,0,14,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="// FINANZAS"
                               FontFamily="{StaticResource ShareTechMonoFont}"
                               Foreground="{StaticResource Cyan}"/>
                    <TextBlock Text="CORTE DE CAJA DEL DÍA"
                               FontFamily="{StaticResource OrbitronFont}"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Margin="0,0,8,8"
                    Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource BorderGradient}"
                    BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" Background="{StaticResource CardInnerBg}"
                            BorderBrush="{StaticResource BorderGradient}" BorderThickness="1" CornerRadius="8">
                        <Path Data="{StaticResource AppIconConsoleGeometry}" Width="22" Height="22" Fill="Transparent"
                              Stroke="{StaticResource Cyan}" StrokeThickness="1.8" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="Consolas" Foreground="{StaticResource TextNav}" FontFamily="{StaticResource OrbitronFont}" FontSize="15"/>
                        <TextBlock x:Name="txtConsolas" Foreground="{StaticResource Free}" FontFamily="{StaticResource ShareTechMonoFont}" FontSize="28"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Margin="8,0,0,8"
                    Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource BorderGradient}"
                    BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" Background="{StaticResource CardInnerBg}"
                            BorderBrush="{StaticResource BorderGradient}" BorderThickness="1" CornerRadius="8">
                        <Path Data="{StaticResource AppIconSaleGeometry}" Width="22" Height="22" Fill="Transparent"
                              Stroke="{StaticResource Cyan}" StrokeThickness="1.8" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="Productos" Foreground="{StaticResource TextNav}" FontFamily="{StaticResource OrbitronFont}" FontSize="15"/>
                        <TextBlock x:Name="txtProductos" Foreground="{StaticResource Free}" FontFamily="{StaticResource ShareTechMonoFont}" FontSize="28"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Margin="0,8,8,8"
                    Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource BorderGradient}"
                    BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" Background="{StaticResource CardInnerBg}"
                            BorderBrush="{StaticResource BorderGradient}" BorderThickness="1" CornerRadius="8">
                        <Path Data="{StaticResource AppIconInventoryGeometry}" Width="22" Height="22" Fill="Transparent"
                              Stroke="{StaticResource DangerGlow}" StrokeThickness="1.8" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="Inventario" Foreground="{StaticResource TextNav}" FontFamily="{StaticResource OrbitronFont}" FontSize="15"/>
                        <TextBlock x:Name="txtInventario" Foreground="{StaticResource DangerGlow}" FontFamily="{StaticResource ShareTechMonoFont}" FontSize="28"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Margin="8,8,0,8"
                    Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource BorderGradient}"
                    BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" Background="{StaticResource CardInnerBg}"
                            BorderBrush="{StaticResource BorderGradient}" BorderThickness="1" CornerRadius="8">
                        <Path Data="{StaticResource AppIconExpensesGeometry}" Width="22" Height="22" Fill="Transparent"
                              Stroke="{StaticResource DangerGlow}" StrokeThickness="1.8" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="Gastos extra" Foreground="{StaticResource TextNav}" FontFamily="{StaticResource OrbitronFont}" FontSize="15"/>
                        <TextBlock x:Name="txtExtras" Foreground="{StaticResource DangerGlow}" FontFamily="{StaticResource ShareTechMonoFont}" FontSize="28"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0"
                    Background="{StaticResource CardInnerBg}"
                    BorderBrush="{StaticResource BorderGradient}" BorderThickness="1" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="TOTAL INGRESOS" Foreground="{StaticResource TextNav}" FontFamily="{StaticResource OrbitronFont}" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtTotalIngresos" Foreground="{StaticResource Free}" FontFamily="{StaticResource ShareTechMonoFont}" FontSize="24" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="TOTAL GASTOS" Foreground="{StaticResource TextNav}" FontFamily="{StaticResource OrbitronFont}" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtTotalGastos" Foreground="{StaticResource DangerGlow}" FontFamily="{StaticResource ShareTechMonoFont}" FontSize="24" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="GANANCIA NETA" Foreground="{StaticResource Price}" FontFamily="{StaticResource OrbitronFont}" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtGanancia" Foreground="{StaticResource Price}" FontFamily="{StaticResource ShareTechMonoFont}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        </Grid>
    </Grid>

</Window>