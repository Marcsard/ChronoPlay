<Window x:Class="ChronoPlay.Views.AdministrarConsolasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ChronoPlay.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Administrar Consolas"
        Background="{StaticResource AppBg}"
        WindowStyle="None"
        controls:WindowWorkAreaBehavior.KeepInWorkArea="True"
        Height="600"
        Width="800"
        MinWidth="640"
        MinHeight="400">
    <Window.Resources>
        <controls:DateTimeDisplayConverter x:Key="DateTimeDisplayConverter"/>
        <Style x:Key="DarkDataGridCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Style="{StaticResource WindowChromeRootStyle}" Background="{StaticResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <controls:AppTitleBar Grid.Row="0"
                              Title="ADMINISTRAR CONSOLAS"
                              IconGeometry="{StaticResource AppIconConsoleGeometry}"/>
        <Grid Grid.Row="1" Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource BorderGradient}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="5" VerticalAlignment="Center">
                    <ContentControl Content="{StaticResource AppIconConsoleGeometry}"
                                    Style="{StaticResource AppIconBadgeStyle}"
                                    Margin="0,0,14,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="// ESTACIONES"
                                   FontFamily="{StaticResource ShareTechMonoFont}"
                                   Foreground="{StaticResource Cyan}"/>
                        <TextBlock Text="ADMINISTRAR CONSOLAS"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="btnAgregar"
                            Content="Agregar Consola"
                            Width="140"
                            Height="40"
                            Margin="4"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="btnAgregar_Click"/>
                    <Button x:Name="btnEditar"
                            Content="Editar"
                            Width="100"
                            Height="40"
                            Margin="4"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="btnEditar_Click"/>
                    <Button x:Name="btnEliminar"
                            Content="Eliminar"
                            Width="100"
                            Height="40"
                            Margin="4"
                            Style="{StaticResource StopButtonStyle}"
                            Click="btnEliminar_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource BorderGradient}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10">
            <DataGrid x:Name="dgConsolas"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="100"/>
                    <DataGridTextColumn Header="Precio/hora" Binding="{Binding PrecioHora, StringFormat={}{0:C}}" Width="120"/>
                    <DataGridCheckBoxColumn Header="Activa" Binding="{Binding Activa}" Width="80"
                                            ElementStyle="{StaticResource DarkDataGridCheckBoxStyle}"
                                            EditingElementStyle="{StaticResource DarkDataGridCheckBoxStyle}"/>
                    <DataGridCheckBoxColumn Header="Ocupada" Binding="{Binding Ocupada}" Width="85"
                                            ElementStyle="{StaticResource DarkDataGridCheckBoxStyle}"
                                            EditingElementStyle="{StaticResource DarkDataGridCheckBoxStyle}"/>
                    <DataGridTextColumn Header="Hora de inicio"
                                        Binding="{Binding HoraInicio, Converter={StaticResource DateTimeDisplayConverter}, ConverterParameter=dd/MM/yyyy HH:mm}"
                                        Width="150"/>
                    <DataGridTextColumn Header="Tiempo jugado" Binding="{Binding TiempoJugado, StringFormat={}{0:hh\\:mm\\:ss}}" Width="125"/>
                    <DataGridTextColumn Header="Tiempo objetivo" Binding="{Binding TiempoObjetivo, StringFormat={}{0:hh\\:mm\\:ss}}" Width="130"/>
                    <DataGridCheckBoxColumn Header="Tiempo libre" Binding="{Binding TiempoLibre}" Width="125"
                                            ElementStyle="{StaticResource DarkDataGridCheckBoxStyle}"
                                            EditingElementStyle="{StaticResource DarkDataGridCheckBoxStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

            </Grid>
        </Grid>

    </Window>