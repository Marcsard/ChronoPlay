<Window x:Class="ChronoPlay.Views.InventarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ChronoPlay.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Inventario"
        Background="{StaticResource AppBg}"
        WindowStyle="None"
        controls:WindowWorkAreaBehavior.KeepInWorkArea="True"
        Height="650"
        Width="1100"
        MinWidth="760"
        MinHeight="450"
        WindowStartupLocation="CenterOwner">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Style="{StaticResource WindowChromeRootStyle}" Background="{StaticResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <controls:AppTitleBar Grid.Row="0"
                              Title="INVENTARIO"
                              IconGeometry="{StaticResource AppIconInventoryGeometry}"/>
        <Grid Grid.Row="1" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource BorderGradient}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="5" VerticalAlignment="Center">
                    <ContentControl Content="{StaticResource AppIconInventoryGeometry}"
                                    Style="{StaticResource AppIconBadgeStyle}"
                                    Margin="0,0,14,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="// EXISTENCIAS"
                                   FontFamily="{StaticResource ShareTechMonoFont}"
                                   Foreground="{StaticResource Cyan}"/>
                        <TextBlock Text="INVENTARIO"
                                   Style="{StaticResource SectionTitleStyle}"
                                   FontSize="26"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="btnAgregar" Content="Agregar" MinWidth="105" Height="40" Margin="4" Style="{StaticResource PrimaryButtonStyle}" Click="btnAgregar_Click"/>
                    <Button x:Name="btnEditar" Content="Editar" MinWidth="90" Height="40" Margin="4" Style="{StaticResource GhostButtonStyle}" Click="btnEditar_Click"/>
                    <Button x:Name="btnEliminar" Content="Eliminar" MinWidth="95" Height="40" Margin="4" Style="{StaticResource StopButtonStyle}" Click="btnEliminar_Click"/>
                    <Border Background="{StaticResource CardInnerBg}"
                            BorderBrush="{StaticResource BorderGradient}"
                            BorderThickness="1"
                            Height="38"
                            Width="190"
                            Margin="4"
                            VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 M16,16 L22,22"
                                  Width="16" Height="16"
                                  Fill="Transparent"
                                  Stroke="{StaticResource TextMuted}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                            <TextBox x:Name="txtBuscar"
                                     Grid.Column="1"
                                     Height="36"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0,6,8,6"
                                     VerticalContentAlignment="Center"
                                     TextChanged="txtBuscar_TextChanged"/>
                        </Grid>
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="8">
            <DataGrid x:Name="dgProductos"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*"/>
                    <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="140"/>
                    <DataGridTextColumn Header="Costo" Binding="{Binding Costo, StringFormat={}{0:C}}" Width="115" ElementStyle="{StaticResource MonoDataGridCellStyle}"/>
                    <DataGridTextColumn Header="Precio venta" Binding="{Binding PrecioVenta, StringFormat={}{0:C}}" Width="130" ElementStyle="{StaticResource MonoDataGridCellStyle}"/>
                    <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="80"/>
                    <DataGridTextColumn Header="Stock mín." Binding="{Binding StockMinimo}" Width="100"/>
                    <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        </Grid>
    </Grid>
</Window>