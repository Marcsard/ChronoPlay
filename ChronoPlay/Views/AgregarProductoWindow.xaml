<Window x:Class="ChronoPlay.Views.AgregarProductoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar Producto"
        Background="{StaticResource AppBg}"
        Height="560"
        Width="440"
        MinWidth="400"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">


    <ScrollViewer Background="{StaticResource AppBg}" VerticalScrollBarVisibility="Auto">
    <Border Margin="20" Style="{StaticResource CardBorderStyle}">
    <StackPanel>

        <TextBlock Text="// CATÁLOGO"
                   FontFamily="{StaticResource ShareTechMonoFont}"
                   Foreground="{StaticResource Cyan}"/>
        <TextBlock Text="AGREGAR PRODUCTO"
                   Style="{StaticResource SectionTitleStyle}"
                   Margin="0,4,0,12"/>

        <TextBlock Text="Nombre" Style="{StaticResource FieldLabelStyle}"/>
        <TextBox x:Name="txtNombre"/>

        <TextBlock Text="Categoría"
                   Margin="0,10,0,0"/>
        <TextBox x:Name="txtCategoria"/>

        <TextBlock Text="Costo"
                   Margin="0,10,0,0"/>
        <TextBox x:Name="txtCosto"/>

        <TextBlock Text="Precio Venta"
                   Margin="0,10,0,0"/>
        <TextBox x:Name="txtVenta"/>

        <TextBlock Text="Stock"
                   Margin="0,10,0,0"/>
        <TextBox x:Name="txtStock"/>

        <TextBlock Text="Proveedor"
                   Margin="0,10,0,0"/>
        <TextBox x:Name="txtProveedor"/>

        <Button Content="Guardar"
                Margin="0,20,0,0"
                Height="35"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="Guardar_Click"/>

    </StackPanel>
    </Border>
    </ScrollViewer>

</Window>