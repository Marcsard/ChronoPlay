<Window x:Class="ChronoPlay.Views.AgregarUsuarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar Usuario"
        Background="{StaticResource AppBg}"
        Height="500"
        Width="440"
        MinWidth="400"
        MinHeight="440"
        WindowStartupLocation="CenterOwner">


    <ScrollViewer Background="{StaticResource AppBg}" VerticalScrollBarVisibility="Auto">
    <Border Margin="20" Style="{StaticResource CardBorderStyle}">
    <StackPanel>

        <TextBlock Text="// ACCESO"
                   FontFamily="{StaticResource ShareTechMonoFont}"
                   Foreground="{StaticResource Cyan}"/>
        <TextBlock Text="AGREGAR USUARIO"
                   Style="{StaticResource SectionTitleStyle}"
                   Margin="0,4,0,12"/>

        <TextBlock Text="Nombre"/>
        <TextBox x:Name="txtNombre"/>

        <TextBlock Text="Usuario"/>
        <TextBox x:Name="txtUsuario"/>

        <TextBlock Text="Contraseña"/>
        <PasswordBox x:Name="txtPassword"/>

        <TextBlock Text="Rol"/>

        <ComboBox x:Name="cmbRol">
            <ComboBoxItem Content="Administrador"/>
            <ComboBoxItem Content="Empleado"/>
        </ComboBox>

        <Button Content="Guardar"
                Margin="0,20,0,0"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="Guardar_Click"/>

    </StackPanel>
    </Border>
    </ScrollViewer>

</Window>