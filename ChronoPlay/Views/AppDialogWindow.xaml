<Window x:Class="ChronoPlay.Views.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ChronoPlay.Controls"
        Title="ChronoPlay"
        Width="460"
        SizeToContent="Height"
        MaxHeight="760"
        Loaded="Window_Loaded"
        MinWidth="420"
        WindowStyle="None"
        controls:WindowWorkAreaBehavior.KeepInWorkArea="True"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Storyboard x:Key="DialogEntranceStoryboard">
            <DoubleAnimation Storyboard.TargetName="DialogSurface"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.18"/>
            <DoubleAnimation Storyboard.TargetName="DialogScaleTransform"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.96" To="1"
                             Duration="0:0:0.18"/>
            <DoubleAnimation Storyboard.TargetName="DialogScaleTransform"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.96" To="1"
                             Duration="0:0:0.18"/>
        </Storyboard>
    </Window.Resources>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource DialogEntranceStoryboard}"/>
        </EventTrigger>
    </Window.Triggers>
    <Grid Background="Transparent" Margin="12">
        <Border x:Name="DialogSurface"
                Background="{StaticResource AppBg}"
                BorderBrush="{Binding AccentBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="24"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.Effect>
                <DropShadowEffect Color="{StaticResource DialogShadowColor}"
                                  BlurRadius="22"
                                  ShadowDepth="0"
                                  Opacity="0.32"/>
            </Border.Effect>
            <Border.RenderTransform>
                <ScaleTransform x:Name="DialogScaleTransform" ScaleX="0.96" ScaleY="0.96"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,12"
                            Cursor="SizeAll"
                            MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Polygon Points="32,1 58,16 58,48 32,63 6,48 6,16"
                                 Fill="{StaticResource AccentGradient}"
                                 Stroke="{Binding AccentBrush}"
                                 StrokeThickness="1.5"/>
                        <Path Data="{Binding IconGeometry}"
                              Width="30" Height="30"
                              Fill="Transparent"
                              Stroke="{Binding AccentBrush}"
                              StrokeThickness="2.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding Header}"
                               FontFamily="{StaticResource ShareTechMonoFont}"
                               Foreground="{StaticResource Cyan}"
                               FontSize="13"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Title}"
                               FontFamily="{StaticResource OrbitronFont}"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="21"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,20">
                    <Border Background="{StaticResource PanelBg}"
                            BorderBrush="{StaticResource BorderGradient}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}"
                                                       FontFamily="{StaticResource OrbitronFont}"
                                                       Foreground="{StaticResource TextNav}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Value}"
                                                       Grid.Column="1"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontWeight="SemiBold"
                                                       TextAlignment="Right"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="260"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Message}"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="15"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Visibility="{Binding MessageVisibility}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource NavActiveBg}"
                            BorderBrush="{Binding AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18"
                            Margin="0,14,0,0"
                            Visibility="{Binding TotalVisibility}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalLabel}"
                                       FontFamily="{StaticResource OrbitronFont}"
                                       Foreground="{Binding AccentBrush}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalValue}"
                                       FontFamily="{StaticResource ShareTechMonoFont}"
                                       Foreground="{StaticResource Price}"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnCancel"
                            Grid.Column="0"
                            Content="{Binding CancelText}"
                            Height="44"
                            Margin="0,0,5,0"
                            Style="{StaticResource GhostButtonStyle}"
                            IsCancel="True"
                            Visibility="{Binding CancelVisibility}"
                            Click="Cancelar_Click"/>
                    <Button x:Name="btnAccept"
                            Grid.Column="1"
                            Content="{Binding ButtonText}"
                            Height="44"
                            Margin="5,0,0,0"
                            IsDefault="True"
                            IsCancel="{Binding IsSingleButton}"
                            Click="Aceptar_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSingleButton}" Value="True">
                                        <Setter Property="Grid.Column" Value="0"/>
                                        <Setter Property="Grid.ColumnSpan" Value="2"/>
                                        <Setter Property="Margin" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
