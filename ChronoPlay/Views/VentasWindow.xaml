<Window x:Class="ChronoPlay.Views.VentasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ventas"
        Background="{StaticResource AppBg}"
        Height="600"
        Width="900"
        MinWidth="700"
        MinHeight="450"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20" Background="{StaticResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="// PUNTO DE VENTA"
                       FontFamily="{StaticResource ShareTechMonoFont}"
                       Foreground="{StaticResource Cyan}"/>
            <TextBlock Text="VENTAS"
                       Style="{StaticResource SectionTitleStyle}"
                       FontSize="24"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <ComboBox x:Name="cmbProductos" Width="300" DisplayMemberPath="Nombre"/>
            <TextBlock Text="Cantidad:" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <TextBox x:Name="txtCantidad" Width="80"/>
            <Button Content="Agregar" Width="100" Margin="10,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="Agregar_Click"/>
        </WrapPanel>

        <DataGrid x:Name="dgTicket"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Producto" Binding="{Binding Producto.Nombre}" Width="*"/>
                <DataGridTextColumn Header="Precio" Binding="{Binding Producto.PrecioVenta}" Width="120"/>
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="100"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button Content="Eliminar" Width="100" DockPanel.Dock="Left" Style="{StaticResource StopButtonStyle}" Click="EliminarProducto_Click"/>
            <Button Content="Cobrar" Width="100" DockPanel.Dock="Right" Style="{StaticResource SuccessButtonStyle}" Click="Cobrar_Click"/>
            <TextBlock x:Name="txtTotal" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
