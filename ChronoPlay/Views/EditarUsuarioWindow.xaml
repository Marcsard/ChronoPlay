<Window x:Class="ChronoPlay.Views.EditarUsuarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Usuario"
        Background="{StaticResource AppBg}"
        Height="450"
        Width="450"
        MinWidth="400"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <ScrollViewer Background="{StaticResource AppBg}" VerticalScrollBarVisibility="Auto">
    <Border Margin="15"
            Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource BorderGradient}"
            BorderThickness="1"
            CornerRadius="8">

        <StackPanel Margin="20">

            <TextBlock Text="// ACCESO"
                       FontFamily="{StaticResource ShareTechMonoFont}"
                       Foreground="{StaticResource Cyan}"/>
            <TextBlock Text="EDITAR USUARIO"
                       FontFamily="{StaticResource OrbitronFont}"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"
                       Margin="0,4,0,16"/>

            <TextBlock Text="Nombre"
                       Foreground="{StaticResource TextNav}"/>

            <TextBox x:Name="txtNombre"
                     Margin="0,5,0,15"/>

            <TextBlock Text="Usuario"
                       Foreground="{StaticResource TextNav}"/>

            <TextBox x:Name="txtUsuario"
                     Margin="0,5,0,15"/>

            <TextBlock Text="Contraseña"
                       Foreground="{StaticResource TextNav}"/>

            <PasswordBox x:Name="txtPassword"
                         Margin="0,5,0,15"/>

            <TextBlock Text="Rol"
                       Foreground="{StaticResource TextNav}"/>

            <ComboBox x:Name="cmbRol"
                      Margin="0,5,0,20">

                <ComboBoxItem Content="Administrador"/>

                <ComboBoxItem Content="Empleado"/>

            </ComboBox>

            <Button Content="Guardar Cambios"
                    Height="40"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Guardar_Click"/>

        </StackPanel>

    </Border>
    </ScrollViewer>

</Window>