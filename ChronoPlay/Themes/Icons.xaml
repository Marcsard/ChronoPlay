    <Style x:Key="AppIconBadgeStyle" TargetType="ContentControl">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Polygon Points="22,1 41,11.5 41,32.5 22,43 3,32.5 3,11.5"
                                 Fill="{StaticResource AccentGradient}"
                                 Stroke="{StaticResource BorderActiveGradient}"
                                 StrokeThickness="1"/>
                        <Path Data="{TemplateBinding Content}"
                              Fill="Transparent"
                              Stroke="{StaticResource TextNav}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"
                              Margin="14"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
