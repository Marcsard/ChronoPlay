        <Setter Property="FontFamily" Value="{StaticResource OrbitronFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Ocupada}" Value="True">
                <Setter Property="Text" Value="●  EN USO"/>
                <Setter Property="Foreground" Value="{StaticResource InUse}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="AvatarHexStyle" TargetType="controls:AvatarHex">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:AvatarHex">
                    <Grid Width="44" Height="48">
                        <Path Data="M 22,1 L 42,12 L 42,36 L 22,47 L 2,36 L 2,12 Z"
                              Fill="{StaticResource AccentGradient}"
                              Stroke="{StaticResource Cyan}"
                              StrokeThickness="1.5">
                            <Path.Effect><DropShadowEffect Color="#5558E8" BlurRadius="12" ShadowDepth="0" Opacity="0.45"/></Path.Effect>
                        </Path>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
