        <Setter Property="Padding" Value="18"/>
        <Setter Property="Effect">
            <Setter.Value><DropShadowEffect Color="#5558E8" BlurRadius="8" ShadowDepth="0" Opacity="0.08"/></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ConsoleCardStyle" TargetType="controls:ChamferBorder">
        <Setter Property="Background" Value="{StaticResource PanelBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderGradient}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="TopLineBrush" Value="{StaticResource AccentLight}"/>
        <Setter Property="CutSize" Value="22"/>
        <Setter Property="Padding" Value="18"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Ocupada}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BorderActiveGradient}"/>
                <Setter Property="TopLineBrush" Value="{StaticResource Cyan}"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#22D3EE" BlurRadius="10" ShadowDepth="0" Opacity="0.12"/>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ConsoleStatusPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardInnerBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Free}"/>
