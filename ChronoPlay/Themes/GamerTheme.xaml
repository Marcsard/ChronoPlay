        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Ocupada}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource InUse}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ConsoleStatusTextStyle" TargetType="TextBlock">
        <Setter Property="Text" Value="●  LIBRE"/>
